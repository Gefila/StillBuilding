{
	"name": "StillBuilding",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --ui=tui",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\" && pnpm --filter @stillbuilding/api check",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"prettier": "^3.7.4",
		"turbo": "^2.10.11",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=18"
	},
	"overrides": {
		"lightningcss": "1.30.1"
	}
}
